POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd_master
DATABASE_URL=postgresql+psycopg://dnd:dnd@localhost:5432/dnd_master
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODEL=gpt-oss-20b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL_2=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL_3=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_DIMENSIONS=1536
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tailscale Funnel HTTPS hosts (optional; SPA is usually same-origin when using start-game)
CORS_ORIGIN_REGEX=https://.*\.ts\.net
HOST=0.0.0.0
PORT=8000
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_GAMEPLAY=30/minute
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=stabilityai/sd-turbo
IMAGE_MODEL_PATH=storage/models/sd-turbo
IMAGE_DEVICE=cpu
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=1
IMAGE_MAX_CONCURRENT=1
ASSET_STORAGE_PATH=storage/assets
LOG_LEVEL=INFO
APP_NAME=D&D Master
DEBUG=true
